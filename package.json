{
  "name": "nai-atelier",
  "private": true,
  "version": "1.51.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --outfile=dist/_worker.js --platform=browser",
    "test:gateway": "node tests/run.mjs gateway",
    "test:secrets": "node scripts/secret-scan.mjs",
    "lint": "eslint .",
    "test": "node tests/run.mjs unit",
    "prepare": "node scripts/setup-local-install.mjs",
    "update:tags": "node --no-warnings scripts/update-tag-dictionary.mjs",
    "preview": "vite preview",
    "dev:local": "node scripts/local-server.mjs",
    "dev:local:quick": "npx wrangler pages dev dist --persist-to ./local-data --binding LOCAL_HISTORY_ENABLED=true --binding PERSONAL_MODE_ENABLED=true --port 3000 --show-interactive-dev-session=false",
    "dev:local:watch": "concurrently -k \"vite build --watch\" \"esbuild worker/index.ts --bundle --format=esm --outfile=dist/_worker.js --platform=browser --watch\" \"npm run dev:local:quick\"",
    "dev:local:win": "scripts\\local-server.bat",
    "dev:local:linux": "sh scripts/local-server.sh",
    "test:live-sync": "node tests/run.mjs live-sync",
    "build:local": "vite build && npm run build:worker",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:desktop:dir": "node scripts/build-desktop.mjs --dir",
    "build:android": "node scripts/build-android.mjs --release",
    "build:android:debug": "node scripts/build-android.mjs",
    "test:android": "node scripts/test-android.mjs"
  },
  "overrides": {
    "shell-quote": "^1.8.5",
    "ws": "8.21.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@noble/ciphers": "2.1.1",
    "@noble/hashes": "2.4.0",
    "buffer": "6.0.3",
    "fast-png": "^8.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.27.0",
    "onnxruntime-node": "1.21.1",
    "path-browserify": "1.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.35.4",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "4.81.1"
  }
}
