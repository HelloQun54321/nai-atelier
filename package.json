{
  "name": "nai-prompt-manager",
  "private": true,
  "version": "0.79.24",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --outfile=dist/_worker.js --platform=browser",
    "test:gateway": "node --test scripts/media-gateway.test.mjs scripts/st-chatu8-bridge.test.mjs scripts/pixiv-local.test.mjs scripts/pixiv-web-login.test.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "prepare": "node scripts/install-git-hooks.mjs",
    "update:tags": "node --no-warnings scripts/update-tag-dictionary.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages project create nai-prompt-manager --production-branch main || true && npx wrangler pages deploy dist --project-name=nai-prompt-manager --commit-message=deploy",
    "manual-deploy": "npm run build && npx wrangler pages deploy dist --project-name=nai-prompt-manager --branch=main --commit-message=deploy",
    "dev:local": "node scripts/local-server.mjs",
    "dev:local:quick": "npx wrangler pages dev dist --persist-to ./local-data --binding LOCAL_HISTORY_ENABLED=true --binding PERSONAL_MODE_ENABLED=true --port 3000 --show-interactive-dev-session=false",
    "dev:local:watch": "concurrently -k \"vite build --watch\" \"esbuild worker/index.ts --bundle --format=esm --outfile=dist/_worker.js --platform=browser --watch\" \"npm run dev:local:quick\"",
    "dev:local:win": "scripts\\local-server.bat",
    "dev:local:linux": "sh scripts/local-server.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.27.0",
    "onnxruntime-node": "1.21.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.81.1"
  }
}
